# ============================================================
# 连接精灵链后端 - 环境变量示例（复制为 .env 并按需填写）
# ============================================================

# 旧版全局 API-Key（兼容旧部署；已配置租户后建议仅作过渡使用）
LINKSPRITE_API_KEY=

# 多租户鉴权：租户 JSON 文件路径（不存在视为空列表，目录自动创建）
LINKSPRITE_TENANTS_FILE=tenants.json

# 审计日志文件路径（按天轮转，实际文件名为 <前缀>-yyyy-MM-dd.jsonl）
LINKSPRITE_AUDIT_LOG=logs/api-audit.jsonl

# 内部运维接口令牌（保护 /internal/**；留空则内部接口返回 503 OPS_DISABLED）
LINKSPRITE_OPS_TOKEN=

# 运行 profile（dev 默认无链、无数据库；收单需要 mysql）
SPRING_PROFILES_ACTIVE=dev

# 收单数据源（mysql profile 生效时使用）
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 链连接开关
FISCO_ENABLED=false
FISCO_DEPLOY_ENABLED=false
FISCO_PEERS=host.docker.internal:20200
